{
  "version": 1,
  "defaults": {
    "target": "spirv",
    "entry": "main"
  },
  "includes": [
    "ray_common"
  ],
  "shaders": [
    { "name": "geometry_vert",    "stage": "vertex" },
    { "name": "geometry_frag",    "stage": "fragment" },
    { "name": "lighting_vert",    "stage": "vertex" },
    { "name": "lighting_frag",    "stage": "fragment",      "deps": ["ray_common"] },
    { "name": "ray_gen",          "stage": "raygeneration", "deps": ["ray_common"] },
    { "name": "ray_miss",         "stage": "miss",          "deps": ["ray_common"] },
    { "name": "ray_closesthit",   "stage": "closesthit",    "deps": ["ray_common"] },
    { "name": "variance_compute", "stage": "compute" },
    { "name": "denoise_compute",  "stage": "compute" }
  ]
}
